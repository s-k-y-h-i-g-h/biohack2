{
  "name": "biohack2",
  "private": true,
  "version": "0.1.0",
  "description": "Biohacker tracking platform — Rust engine + Leptos WASM frontend",
  "scripts": {
    "build": "bash build-web.sh",
    "test": "cargo test --workspace && wasm-pack test --headless --chrome web",
    "lint": "cargo clippy --workspace",
    "format": "cargo fmt --all",
    "serve": "python server.py",
    "dev": "bash build-web.sh && python server.py"
  }
}
